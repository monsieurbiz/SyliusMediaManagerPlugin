<div class="list-group">
    {% for file in files %}
        {% set fileIcon = file.isDir ? 'bi-folder' : file.isImage ? 'bi-image' : file.isVideo ? 'bi-play-circle' : file.isPdf ? 'bi-file-pdf' : file.isFavicon ? 'bi-image' : file.isAudio ? 'bi-music-note' : file.isFile ? 'bi-file-earmark' : 'bi-question-circle' %}
        <div class="list-group-item d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center monsieurbiz-sylius-file-manager__item"
            {%- if file.isDir -%}onclick="monsieurbizSyliusMediaManagerDisplayPath('{{ inputName | escape('js') }}', '{{ folder | escape('js')}}', '{{ file.path | escape('js')}}', '{{ mimeTypes|escape('js') }}');" style="cursor: pointer;"{%- endif -%}
            {%- if file.isFile -%}onclick="monsieurbizSyliusMediaManagerConfirmFile('{{ inputName | escape('js') }}', '{{ folder | escape('js')}}', '{{ file.path | escape('js')}}');" style="cursor: pointer;"{%- endif -%}
            >
                <i class="bi {{ fileIcon }} me-2"></i>
                <div class="{{ file.isDir ? 'fw-bold' : '' }}">
                    {{ file.name }}
                </div>
            </div>
            <div class="d-flex gap-2">
                {% include '@MonsieurBizSyliusMediaManagerPlugin/Admin/MediaManager/Modal/Content/Files/_previewFile.html.twig' %}
                {% include '@MonsieurBizSyliusMediaManagerPlugin/Admin/MediaManager/Modal/Content/Files/_deleteFile.html.twig' %}
            </div>
        </div>
    {% endfor %}
</div>
