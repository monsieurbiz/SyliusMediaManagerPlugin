{% if path is not empty %}
    <div class="d-flex align-items-center gap-2 monsieurbiz-sylius-file-manager__item monsieurbiz-sylius-file-manager__item-rename-folder">
        <button type="button"
            class="btn btn-secondary btn-sm monsieurbiz-sylius-file-manager__rename-folder-label"
            onclick="this.style.display='none';this.parentNode.querySelector('.monsieurbiz-sylius-file-manager__rename-folder').style.display='block';this.parentNode.querySelector('.monsieurbiz-sylius-file-manager__rename-folder input').focus();"
        >
            <i class="bi bi-pencil me-1"></i>
            {{ 'monsieurbiz_sylius_media_manager.ui.rename_folder' | trans }}
        </button>

        {# Form to rename folder #}
        <div class="d-none monsieurbiz-sylius-file-manager__rename-folder">
            <div class="input-group input-group-sm">
                <input type="text" name="folder" class="form-control" placeholder="{{ 'monsieurbiz_sylius_media_manager.ui.folder_name' | trans }}" />
                <button type="button" class="btn btn-warning btn-sm"
                    onclick="monsieurbizSyliusMediaManagerRenameFolder(this.parentNode.querySelector('input'), '{{ inputName | escape('js') }}', '{{ folder | escape('js')}}', '{{ path | escape('js')}}', '{{ 'monsieurbiz_sylius_media_manager.ui.rename_folder_confirm'| trans({'%path%': path}) | escape('js') }}', '{{ 'monsieurbiz_sylius_media_manager.ui.rename_folder_confirm_bis'| trans() }}', '{{ mimeTypes|escape('js') }}')"
                >
                    {{ 'monsieurbiz_sylius_media_manager.ui.rename' | trans }}
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm"
                    onclick="this.parentNode.parentNode.style.display='none';this.parentNode.parentNode.previousElementSibling.style.display='block';"
                >
                    {{ 'monsieurbiz_sylius_media_manager.ui.cancel' | trans }}
                </button>
            </div>
        </div>
    </div>
{% endif %}
