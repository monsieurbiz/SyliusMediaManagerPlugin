<div class="d-flex align-items-center gap-2 monsieurbiz-sylius-file-manager__item monsieurbiz-sylius-file-manager__item-new-folder">
    {# Button to create folder #}
    <button type="button"
        class="btn btn-outline-primary btn-sm monsieurbiz-sylius-file-manager__new-folder-label"
        onclick="this.style.display='none';this.parentNode.querySelector('.monsieurbiz-sylius-file-manager__new-folder').style.display='block';this.parentNode.querySelector('.monsieurbiz-sylius-file-manager__new-folder input').focus();"
    >
        <i class="bi bi-plus-lg me-1"></i>
        {{ 'monsieurbiz_sylius_media_manager.ui.create_folder' | trans }}
    </button>

    {# Form to create folder #}
    <div class="d-none monsieurbiz-sylius-file-manager__new-folder">
        <div class="input-group input-group-sm">
            <input type="text" name="folder" class="form-control" placeholder="{{ 'monsieurbiz_sylius_media_manager.ui.folder_name' | trans }}" />
            <button type="button" class="btn btn-success btn-sm"
                onclick="monsieurbizSyliusMediaManagerCreateFolder(this.parentNode.querySelector('input'), '{{ inputName | escape('js') }}', '{{ folder | escape('js')}}', '{{ path | escape('js')}}', '{{ mimeTypes|escape('js') }}')"
            >
                {{ 'monsieurbiz_sylius_media_manager.ui.create' | trans }}
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm"
                onclick="this.parentNode.parentNode.style.display='none';this.parentNode.parentNode.previousElementSibling.style.display='block';"
            >
                    {{ 'monsieurbiz_sylius_media_manager.ui.cancel' | trans }}
            </button>
        </div>
    </div>
</div>
