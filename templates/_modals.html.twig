<twig:MediaManager:SelectionModal />
<twig:MediaManager:ConfirmationModal />

<script type="module">
    const modalList = {};
    const getModal = (name) => {
        const modalElement = document.getElementById(name);
        if (!modalElement) {
            return null;
        }
        return modalList[name] ??= new bootstrap.Modal(modalElement);
    }
    document.addEventListener('DOMContentLoaded', () => {
        window.addEventListener('media_manager:modal:open', event => {
          getModal(event.detail.modalName ?? null)?.show();
        });
        window.addEventListener('media_manager:modal:close', event => {
          getModal(event.detail.modalName ?? null)?.hide();
        });
    });
</script>
