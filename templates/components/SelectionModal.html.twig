<div {{ attributes }}>
    <div
            class="modal modal-lg fade modal-dialog-scrollable"
            id="{{ constant('\\MonsieurBiz\\SyliusMediaManagerPlugin\\Components\\SelectionModal::SELECTION_MODAL_NAME') }}"
            tabindex="-1"
            aria-labelledby="mediaManagerModalLabel"
            aria-hidden="true"
    >
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <twig:MediaManager:SelectionModal:DirectoryManager
                        :absoluteDirectoryPath="this.absoluteDirectoryPath"
                        :relativeRootDirectoryPath="this.baseFolderPath"
                    />
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body d-flex flex-column gap-2">

                    {% if this.successMessage is not null %}
                        <div class="alert alert-success w-100 alert-dismissible fade show" role="alert">
                            {{ this.successMessage|trans }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endif %}

                    {% if this.errorMessage is not null %}
                        <div class="alert alert-danger w-100 alert-dismissible fade show" role="alert">
                            {{ this.errorMessage|trans(this.errorParameters) }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endif %}

                    <twig:MediaManager:SelectionModal:FileListManager
                        :inputName="this.inputName"
                        :fileType="this.fileType"
                        :absoluteDirectoryPath="this.absoluteDirectoryPath"
                        :relativeRootDirectoryPath="this.baseFolderPath"
                    />
                </div>
                <div class="modal-footer d-flex flex-column">
                    <twig:MediaManager:SelectionModal:UploadManager
                        :absoluteDirectoryPath="this.absoluteDirectoryPath"
                        :fileType="this.fileType"
                        :mimeTypes="this.mimeTypes"
                        :maxFileSize="this.maxFileSize"
                    />
                </div>
            </div>
        </div>
    </div>
</div>
