{% extends '@SyliusAdmin/shared/components/confirmation_modal.html.twig' %}

{% set modal_id = constant('\\MonsieurBiz\\SyliusMediaManagerPlugin\\Components\\ConfirmationModal::CONFIRMATION_MODAL_NAME') %}

{% block content %}
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">{{ 'sylius.ui.are_your_sure_you_want_to_perform_this_action'|trans }}</h5>
        </div>
        <div class="modal-body">
            {% if this.isLoaded == false %}
                <div class="d-flex justify-content-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            {% else %}
                <div class="alert alert-warning d-flex align-items-center gap-2" role="alert">
                    {{ ux_icon('tabler:alert-triangle', {'class': 'icon text-warning'}) }}
                    <div>
                        {% if this.reconfirmMessage and this.isReconfirmation %}
                            {{ this.reconfirmMessage|trans(this.reconfirmMessageParameters) }}
                        {% else %}
                            {{ this.message|trans(this.messageParameters) }}
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>
        <div class="modal-footer">
            <button
                    type="button"
                    class="btn btn-secondary"
                    data-action="live#action"
                    data-live-action-param="close"
            >
                {{ 'sylius.ui.cancel'|trans }}
            </button>
            {% if this.reconfirmMessage and not this.isReconfirmation %}
                <button
                        type="button"
                        class="btn btn-danger"
                        data-action="live#action"
                        data-live-action-param="reconfirm"
                >
                    {{ this.confirmLabel|trans }}
                </button>
            {% else %}
                <button
                        type="submit"
                        class="btn btn-danger"
                        data-action="live#action"
                        data-live-action-param="confirm"
                >
                    {{ this.confirmLabel|trans }}
                </button>
            {% endif %}
        </div>
    </div>
{% endblock %}


