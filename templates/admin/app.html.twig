    function monsieurbizSyliusMediaManagerRenameFolder(folderInput, inputName, folder, path, confirmationMessage, confirmationMessageBis, mimeTypes)
    {
      if (!confirm(confirmationMessage) || !confirm(confirmationMessageBis)) {
        return;
      }

      let req = new XMLHttpRequest();

      let data = new FormData();
      data.append('newName', folderInput.value);
      data.append('folder', folder);
      data.append('path', path);

      req.onload = function(progress) {
        let response = JSON.parse(this.responseText);
        if (this.status === 200) {
          monsieurbizSyliusMediaManagerRemoveLoaderModal();
          monsieurbizSyliusMediaManagerDisplayPath(inputName, folder, response['path'], mimeTypes);
        } else {
          alert(response['error']);
          monsieurbizSyliusMediaManagerRemoveLoaderModal();
        }
      };
      req.open("post", "{{ path('monsieurbiz_sylius_media_manager_admin_browser_rename_folder') }}", true);
      req.setRequestHeader("X-Requested-With", "XMLHttpRequest");
      req.send(data);
      monsieurbizSyliusMediaManagerAddLoaderModal();
    }

    function monsieurbizSyliusMediaManagerCloseModal()
    {
        let modalElement = document.querySelector('.monsieurbiz-sylius-file-manager__modal');
        if (modalElement) {
            let bsModal = modalElement.bsModalInstance || window.bootstrap.Modal.getInstance(modalElement);
            if (bsModal) {
                bsModal.hide();
            }
        }

        // Force cleanup immediately and with timeout
        const cleanup = () => {
            // Remove modal elements
            document.querySelectorAll('.monsieurbiz-sylius-file-manager__modal').forEach(el => el.remove());
            // Remove Bootstrap backdrop
            document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
            // Remove modal-open class from body
            document.body.classList.remove('modal-open');
            // Reset body style completely
            document.body.style.overflow = '';
            document.body.style.paddingRight = '';
            document.body.style.removeProperty('overflow');
            document.body.style.removeProperty('padding-right');
            // Force scroll restoration
            document.documentElement.style.overflow = '';
            document.documentElement.style.removeProperty('overflow');
        };

        cleanup();
        setTimeout(cleanup, 100);
        setTimeout(cleanup, 300);
    }

    function monsieurbizSyliusMediaManagerAddLoaderModal()
    {
        document.querySelectorAll('.monsieurbiz-sylius-file-manager__loader').forEach(function(modal) {
            modal.classList.remove('d-none');
            modal.classList.add('d-flex');
        });
    }

    function monsieurbizSyliusMediaManagerRemoveLoaderModal()
    {
        document.querySelectorAll('.monsieurbiz-sylius-file-manager__loader').forEach(function(modal) {
            modal.classList.add('d-none');
            modal.classList.remove('d-flex');
        });
    }

    // Fonctions de pagination
    function changePage(inputName, folder, path, mimeTypes, page, itemsPerPage)
    {
        monsieurbizSyliusMediaManagerDisplayPathWithPagination(inputName, folder, path, mimeTypes, page, itemsPerPage);
    }

    function changeItemsPerPage(inputName, folder, path, mimeTypes, itemsPerPage)
    {
        monsieurbizSyliusMediaManagerDisplayPathWithPagination(inputName, folder, path, mimeTypes, 1, itemsPerPage);
    }

    function monsieurbizSyliusMediaManagerDisplayPathWithPagination(inputName, folder, path, mimeTypes, page, itemsPerPage)
    {
        let req = new XMLHttpRequest();
        const params = new URLSearchParams({
            path: path,
            inputName: inputName,
            folder: folder,
            mimeTypes: mimeTypes,
            page: page || 1,
            itemsPerPage: itemsPerPage || 20,
        });
        req.onload = function(progress) {
            if (this.status === 200) {
                // Remplacer le contenu de la modal existante
                let existingModal = document.querySelector('.monsieurbiz-sylius-file-manager__modal');
                if (existingModal) {
                    let tempDiv = document.createElement('div');
                    tempDiv.innerHTML = this.responseText;
                    let newModalContent = tempDiv.firstElementChild;

                    // Remplacer le contenu de la modal
                    existingModal.innerHTML = newModalContent.innerHTML;
                }
                monsieurbizSyliusMediaManagerRemoveLoaderModal();
            } else {
                alert(this.responseText);
                monsieurbizSyliusMediaManagerRemoveLoaderModal();
            }
        };
        req.open("get", "{{ path('monsieurbiz_sylius_media_manager_admin_browser_list') }}?" + params.toString(), true);
        req.setRequestHeader("X-Requested-With", "XMLHttpRequest");
        req.send();
        monsieurbizSyliusMediaManagerAddLoaderModal();
    }
</script>


