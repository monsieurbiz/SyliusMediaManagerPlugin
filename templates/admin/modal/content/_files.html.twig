<div>
    {% for file in files %}
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center monsieurbiz-sylius-file-manager__item w-100"
            {%- if file.isDir -%}onclick="monsieurbizSyliusMediaManagerDisplayPath('{{ inputName | escape('js') }}', '{{ folder | escape('js')}}', '{{ file.path | escape('js')}}', '{{ mimeTypes|escape('js') }}');" style="cursor: pointer;"{%- endif -%}
            {%- if file.isFile -%}onclick="monsieurbizSyliusMediaManagerConfirmFile('{{ inputName | escape('js') }}', '{{ folder | escape('js')}}', '{{ file.path | escape('js')}}');" style="cursor: pointer;"{%- endif -%}
            >
                {% if file.isDir %}
                    {{ ux_icon('tabler:folder') }}
                {% elseif file.isImage %}
                    {{ ux_icon('tabler:photo') }}
                {% elseif file.isVideo %}
                    {{ ux_icon('tabler:video') }}
                {% elseif file.isPdf %}
                    {{ ux_icon('tabler:pdf') }}
                {% elseif file.isFavicon %}
                    {{ ux_icon('tabler:photo') }}
                {% elseif file.isAudio %}
                    {{ ux_icon('tabler:music') }}
                {% elseif file.isFile %}
                    {{ ux_icon('tabler:file') }}
                {% else %}
                    {{ ux_icon('tabler:help') }}
                {% endif %}
                <div class="{{ file.isDir ? 'fw-bold' : '' }} ms-2">
                    {{ file.name }}
                </div>
            </div>
            <div class="d-flex gap-2">
                {% include '@MonsieurBizSyliusMediaManagerPlugin/admin/modal/content/files/_previewFile.html.twig' %}
                {% include '@MonsieurBizSyliusMediaManagerPlugin/admin/modal/content/files/_deleteFile.html.twig' %}
            </div>
        </div>
    {% endfor %}
</div>
